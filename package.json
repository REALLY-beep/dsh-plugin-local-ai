{
  "name": "dsh-local-ai-workbench",
  "version": "0.1.2",
  "description": "DSH desktop plugin for managing and running local GGUF models with llama.cpp",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./logic": "./lib/logic.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "images"
  ],
  "icon": "./images/icon.svg",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/logic.js && node --check lib/model-scanner.js && node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7-rc.1"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "gguf",
    "llama.cpp",
    "llama-server",
    "local-ai",
    "local-llm"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-rc.1"
  },
  "license": "MIT"
}
